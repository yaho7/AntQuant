# OPTIONAL. LumiBot UI needs no .env file: the admin account and the Alpaca
# keys are set in the browser on first start. Use these only to override
# defaults (for example with `env_file: .env` in compose.yaml).
# Never put broker keys here; enter them in Settings, where they are encrypted.

# Send the session cookie only over HTTPS (turn on behind a TLS proxy).
# LUMIBOT_UI_COOKIE_SECURE=true

# Session lifetime in hours (default 168 = 7 days).
# LUMIBOT_UI_SESSION_HOURS=168

# DEBUG, INFO, WARNING or ERROR.
# LUMIBOT_UI_LOG_LEVEL=INFO

# Data folder inside the container (default /data).
# LUMIBOT_UI_DATA_DIR=/data
